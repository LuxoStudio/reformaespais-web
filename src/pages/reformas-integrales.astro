---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Reformas Integrales | Reforma Espais"
  description="Especialistas en reformas integrales en Tarragona."
>

  <Navbar />

  <main>

    <section class="service-hero">

      <div class="container">

        <span class="service-badge">
          REFORMAS INTEGRALES
        </span>

        <h1>
          Reformas integrales para transformar tu vivienda
        </h1>

        <p>
          Diseñamos y ejecutamos reformas completas adaptadas a tus necesidades,
          cuidando cada detalle para conseguir espacios funcionales, modernos
          y duraderos.
        </p>

      </div>

    </section>

  </main>

  <Footer />

</Layout>