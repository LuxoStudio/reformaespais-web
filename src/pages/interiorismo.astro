---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import CTA from "../components/cta.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Interiorismo en Tarragona | Reforma Espais"
  description="Interiorismo en Tarragona para crear espacios equilibrados, funcionales y con personalidad, cuidando cada detalle."
>

  <Navbar />

  <main>

    <!-- =========================================
         HERO
    ========================================== -->

    <section class="interior-hero">

      <div class="container">

        <div class="interior-hero-content">

          <span class="interior-badge">
            INTERIORISMO
          </span>

          <h1>
            Espacios que hablan
            <span>de ti</span>
          </h1>

          <p>
            Diseñamos interiores en Tarragona que combinan
            funcionalidad, armonía y personalidad para crear
            espacios en los que realmente quieras vivir.
          </p>

          <div class="interior-hero-actions">

            <a href="#contacto" class="interior-btn-primary">
              Solicitar presupuesto
            </a>

            <a href="#proceso" class="interior-btn-secondary">
              Cómo trabajamos
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         INTRODUCCIÓN
    ========================================== -->

    <section class="interior-intro">

      <div class="container">

        <div class="interior-intro-grid">

          <div class="interior-section-heading">

            <span>DISEÑO CON SENTIDO</span>

            <h2>
              Un espacio bonito también tiene que funcionar
            </h2>

          </div>

          <div class="interior-intro-text">

            <p>
              El interiorismo no consiste simplemente en elegir
              colores y muebles. Se trata de entender cómo quieres
              utilizar cada espacio y qué sensación quieres transmitir.
            </p>

            <p>
              Trabajamos la distribución, los materiales, la
              iluminación, los colores y los elementos decorativos
              para conseguir interiores equilibrados y coherentes.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         SERVICIOS
    ========================================== -->

    <section class="interior-services">

      <div class="container">

        <div class="section-header">

          <span>INTERIORISMO A MEDIDA</span>

          <h2>
            Cada espacio tiene su propia personalidad
          </h2>

          <p>
            Diseñamos cada proyecto teniendo en cuenta la vivienda,
            tus necesidades y la forma en la que quieres disfrutarla.
          </p>

        </div>


        <div class="interior-features">

          <article class="interior-feature">

            <div class="interior-feature-number">
              01
            </div>

            <h3>
              Distribución
            </h3>

            <p>
              Estudiamos los espacios para mejorar circulación,
              proporciones y funcionalidad.
            </p>

          </article>


          <article class="interior-feature">

            <div class="interior-feature-number">
              02
            </div>

            <h3>
              Materiales y colores
            </h3>

            <p>
              Creamos una combinación equilibrada de materiales,
              texturas y colores que dé personalidad al proyecto.
            </p>

          </article>


          <article class="interior-feature">

            <div class="interior-feature-number">
              03
            </div>

            <h3>
              Iluminación
            </h3>

            <p>
              Diseñamos la iluminación para crear ambientes cómodos,
              funcionales y agradables durante todo el día.
            </p>

          </article>


          <article class="interior-feature">

            <div class="interior-feature-number">
              04
            </div>

            <h3>
              Mobiliario y detalles
            </h3>

            <p>
              Seleccionamos muebles, textiles y elementos decorativos
              que completan el conjunto sin sobrecargarlo.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================
         PROCESO
    ========================================== -->

    <section class="interior-process" id="proceso">

      <div class="container">

        <div class="section-header">

          <span>NUESTRO PROCESO</span>

          <h2>
            Del concepto al espacio terminado
          </h2>

          <p>
            Convertimos tus ideas en un proyecto coherente,
            cuidando cada decisión hasta el resultado final.
          </p>

        </div>


        <div class="interior-process-grid">

          <article class="interior-process-step">

            <span>01</span>

            <h3>
              Escuchamos tus ideas
            </h3>

            <p>
              Conocemos tus gustos, necesidades y la forma en
              la que quieres disfrutar de tu vivienda.
            </p>

          </article>


          <article class="interior-process-step">

            <span>02</span>

            <h3>
              Creamos el concepto
            </h3>

            <p>
              Definimos una línea estética y funcional que
              sirva como base para todo el proyecto.
            </p>

          </article>


          <article class="interior-process-step">

            <span>03</span>

            <h3>
              Seleccionamos cada elemento
            </h3>

            <p>
              Trabajamos materiales, colores, iluminación,
              mobiliario y todos los detalles necesarios.
            </p>

          </article>


          <article class="interior-process-step">

            <span>04</span>

            <h3>
              Damos vida al proyecto
            </h3>

            <p>
              Coordinamos y supervisamos el resultado para
              conseguir un espacio equilibrado y cuidado.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================
         CTA
    ========================================== -->

    <CTA />


    <!-- =========================================
         CONTACTO
    ========================================== -->

    <section id="contacto">
      <Contact />
    </section>

  </main>

  <Footer />

</Layout>