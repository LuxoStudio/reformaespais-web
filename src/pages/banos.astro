---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import CTA from "../components/CTA.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Reformas de Baños en Tarragona | Reforma Espais"
  description="Reformamos baños en Tarragona creando espacios funcionales, actuales y cuidados hasta el último detalle."
>

  <Navbar />

  <main>

    <!-- =========================================
         HERO
    ========================================== -->

    <section class="bathroom-hero">

      <div class="container">

        <div class="bathroom-hero-content">

          <span class="bathroom-badge">
            REFORMAS DE BAÑOS
          </span>

          <h1>
            Baños que combinan
            <span>diseño y bienestar</span>
          </h1>

          <p>
            Reformamos baños en Tarragona creando espacios
            funcionales, cómodos y actuales, pensados para
            disfrutar cada día.
          </p>

          <div class="bathroom-hero-actions">

            <a href="#contacto" class="bathroom-btn-primary">
              Solicitar presupuesto
            </a>

            <a href="#proceso" class="bathroom-btn-secondary">
              Cómo trabajamos
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         INTRODUCCIÓN
    ========================================== -->

    <section class="bathroom-intro">

      <div class="container">

        <div class="bathroom-intro-grid">

          <div class="bathroom-section-heading">

            <span>UN BAÑO PENSADO PARA TI</span>

            <h2>
              Aprovechar el espacio sin renunciar al diseño
            </h2>

          </div>

          <div class="bathroom-intro-text">

            <p>
              Un baño bien diseñado debe aprovechar cada centímetro,
              facilitar el día a día y transmitir una sensación de
              orden y bienestar.
            </p>

            <p>
              Estudiamos la distribución, los sanitarios, el
              almacenamiento, la iluminación y los materiales para
              crear un espacio práctico y coherente con tu vivienda.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         SERVICIOS
    ========================================== -->

    <section class="bathroom-services">

      <div class="container">

        <div class="section-header">

          <span>DISEÑO Y REFORMA</span>

          <h2>
            Cada detalle cuenta
          </h2>

          <p>
            Nos ocupamos de todos los elementos necesarios para
            transformar tu baño en un espacio funcional y cuidado.
          </p>

        </div>


        <div class="bathroom-features">

          <article class="bathroom-feature">

            <div class="bathroom-feature-number">
              01
            </div>

            <h3>
              Distribución
            </h3>

            <p>
              Analizamos el espacio para conseguir una distribución
              cómoda y aprovechar cada metro disponible.
            </p>

          </article>


          <article class="bathroom-feature">

            <div class="bathroom-feature-number">
              02
            </div>

            <h3>
              Sanitarios y mobiliario
            </h3>

            <p>
              Seleccionamos sanitarios, muebles y soluciones de
              almacenamiento adaptadas al proyecto.
            </p>

          </article>


          <article class="bathroom-feature">

            <div class="bathroom-feature-number">
              03
            </div>

            <h3>
              Revestimientos
            </h3>

            <p>
              Te ayudamos a elegir pavimentos y revestimientos
              resistentes que definan el estilo del espacio.
            </p>

          </article>


          <article class="bathroom-feature">

            <div class="bathroom-feature-number">
              04
            </div>

            <h3>
              Iluminación y acabados
            </h3>

            <p>
              Cuidamos iluminación, grifería, espejos y cada
              detalle que completa el resultado final.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================
         PROCESO
    ========================================== -->

    <section class="bathroom-process" id="proceso">

      <div class="container">

        <div class="section-header">

          <span>NUESTRO PROCESO</span>

          <h2>
            Una reforma clara de principio a fin
          </h2>

          <p>
            Te acompañamos durante todo el proyecto para que
            el proceso sea sencillo y el resultado cumpla tus
            expectativas.
          </p>

        </div>


        <div class="bathroom-process-grid">

          <article class="bathroom-process-step">

            <span>01</span>

            <h3>
              Conocemos tus necesidades
            </h3>

            <p>
              Analizamos el baño actual, el espacio disponible
              y aquello que quieres mejorar.
            </p>

          </article>


          <article class="bathroom-process-step">

            <span>02</span>

            <h3>
              Diseñamos el espacio
            </h3>

            <p>
              Definimos distribución, sanitarios, mobiliario,
              materiales e iluminación.
            </p>

          </article>


          <article class="bathroom-process-step">

            <span>03</span>

            <h3>
              Coordinamos la reforma
            </h3>

            <p>
              Organizamos los diferentes trabajos para mantener
              la obra controlada y reducir imprevistos.
            </p>

          </article>


          <article class="bathroom-process-step">

            <span>04</span>

            <h3>
              Cuidamos el resultado
            </h3>

            <p>
              Supervisamos cada fase y los acabados hasta
              entregar tu nuevo baño terminado.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================
         CTA
    ========================================== -->

    <CTA />


    <!-- =========================================
         CONTACTO
    ========================================== -->

    <section id="contacto">
      <Contact />
    </section>

  </main>

  <Footer />

</Layout>