---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import CTA from "../components/cta.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Reformas de Cocinas en Tarragona | Reforma Espais"
  description="Diseñamos y reformamos cocinas en Tarragona a medida, cuidando la distribución, los materiales, la funcionalidad y cada detalle."
>

  <Navbar />

  <main>

    <!-- =========================================
         HERO
    ========================================== -->

    <section class="kitchen-hero">

      <div class="container">

        <div class="kitchen-hero-content">

          <span class="kitchen-badge">
            REFORMAS DE COCINAS
          </span>

          <h1>
            Cocinas pensadas
            <span>para vivirlas</span>
          </h1>

          <p>
            Diseñamos y reformamos cocinas en Tarragona
            combinando funcionalidad, diseño y materiales
            pensados para durar.
          </p>

          <div class="kitchen-hero-actions">

            <a href="#contacto" class="kitchen-btn-primary">
              Solicitar presupuesto
            </a>

            <a href="#proceso" class="kitchen-btn-secondary">
              Cómo trabajamos
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         INTRODUCCIÓN
    ========================================== -->

    <section class="kitchen-intro">

      <div class="container">

        <div class="kitchen-intro-grid">

          <div class="kitchen-section-heading">

            <span>MUCHO MÁS QUE UNA COCINA</span>

            <h2>
              Un espacio pensado para tu día a día
            </h2>

          </div>

          <div class="kitchen-intro-text">

            <p>
              La cocina es uno de los espacios que más utilizamos
              de una vivienda. Por eso una buena reforma no consiste
              simplemente en cambiar muebles.
            </p>

            <p>
              Estudiamos la distribución, las zonas de trabajo,
              el almacenamiento, la iluminación y los materiales
              para conseguir una cocina bonita, cómoda y funcional.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         QUÉ HACEMOS
    ========================================== -->

    <section class="kitchen-services">

      <div class="container">

        <div class="section-header">

          <span>DISEÑO Y REFORMA</span>

          <h2>
            Todo lo que tu cocina necesita
          </h2>

          <p>
            Nos ocupamos de cada parte del proyecto para que
            el resultado final tenga sentido como conjunto.
          </p>

        </div>


        <div class="kitchen-features">

          <article class="kitchen-feature">

            <div class="kitchen-feature-number">
              01
            </div>

            <h3>
              Distribución
            </h3>

            <p>
              Estudiamos el espacio y planteamos una distribución
              que aproveche cada metro de forma inteligente.
            </p>

          </article>


          <article class="kitchen-feature">

            <div class="kitchen-feature-number">
              02
            </div>

            <h3>
              Mobiliario
            </h3>

            <p>
              Seleccionamos soluciones de almacenamiento y
              mobiliario adaptadas al espacio y a tus necesidades.
            </p>

          </article>


          <article class="kitchen-feature">

            <div class="kitchen-feature-number">
              03
            </div>

            <h3>
              Encimeras y materiales
            </h3>

            <p>
              Te ayudamos a elegir materiales resistentes,
              prácticos y coherentes con el estilo de la vivienda.
            </p>

          </article>


          <article class="kitchen-feature">

            <div class="kitchen-feature-number">
              04
            </div>

            <h3>
              Iluminación y detalles
            </h3>

            <p>
              Cuidamos iluminación, revestimientos, grifería
              y todos los elementos que completan el proyecto.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================
         PROCESO
    ========================================== -->

    <section class="kitchen-process" id="proceso">

      <div class="container">

        <div class="section-header">

          <span>NUESTRO PROCESO</span>

          <h2>
            De la primera idea a tu nueva cocina
          </h2>

          <p>
            Te acompañamos durante todo el proceso para que
            cada decisión tenga un objetivo claro.
          </p>

        </div>


        <div class="kitchen-process-grid">

          <article class="kitchen-process-step">

            <span>01</span>

            <h3>
              Conocemos tu espacio
            </h3>

            <p>
              Analizamos la cocina actual, sus posibilidades
              y aquello que necesitas mejorar.
            </p>

          </article>


          <article class="kitchen-process-step">

            <span>02</span>

            <h3>
              Diseñamos la propuesta
            </h3>

            <p>
              Definimos distribución, mobiliario, materiales
              y soluciones adaptadas a tu proyecto.
            </p>

          </article>


          <article class="kitchen-process-step">

            <span>03</span>

            <h3>
              Planificamos la reforma
            </h3>

            <p>
              Coordinamos los trabajos necesarios para que
              la ejecución avance de forma ordenada.
            </p>

          </article>


          <article class="kitchen-process-step">

            <span>04</span>

            <h3>
              Disfrutas de tu nueva cocina
            </h3>

            <p>
              Ejecutamos el proyecto y cuidamos los acabados
              hasta entregar el espacio terminado.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================
         CTA
    ========================================== -->

    <CTA />


    <!-- =========================================
         CONTACTO
    ========================================== -->

    <section id="contacto">
      <Contact />
    </section>

  </main>

  <Footer />

</Layout>