---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const {title,description}=Astro.props;
---

<!DOCTYPE html>

<html lang="es">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>{title}</title>

<meta name="description" content={description}>

</head>

<body>

<slot />

<a
  href="https://wa.me/34616228442?text=Hola%20Reforma%20Espais%2C%20me%20gustar%C3%ADa%20pedir%20informaci%C3%B3n%20sobre%20una%20reforma."
  class="whatsapp-float"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar con Reforma Espais por WhatsApp"
>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path d="M19.11 17.21c-.27-.14-1.59-.78-1.84-.87-.25-.09-.43-.14-.61.14-.18.27-.7.87-.86 1.05-.16.18-.32.2-.59.07-.27-.14-1.14-.42-2.17-1.34-.8-.71-1.34-1.59-1.5-1.86-.16-.27-.02-.42.12-.56.12-.12.27-.32.41-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.61-1.47-.84-2.01-.22-.53-.45-.46-.61-.47h-.52c-.18 0-.48.07-.73.34-.25.27-.95.93-.95 2.27s.98 2.63 1.11 2.81c.14.18 1.93 2.95 4.67 4.14.65.28 1.16.45 1.56.57.66.21 1.26.18 1.73.11.53-.08 1.59-.65 1.81-1.27.23-.62.23-1.15.16-1.27-.07-.11-.25-.18-.52-.32z"/>
    <path d="M16.01 3.2c-7.07 0-12.8 5.73-12.8 12.8 0 2.26.59 4.38 1.63 6.22L3.2 28.8l6.73-1.61a12.75 12.75 0 0 0 6.08 1.54h.01c7.06 0 12.79-5.73 12.79-12.8S23.08 3.2 16.01 3.2zm0 23.35h-.01a10.53 10.53 0 0 1-5.36-1.47l-.38-.23-4 .96.99-3.9-.25-.4a10.55 10.55 0 1 1 9.01 5.04z"/>
  </svg>

  <span>¿Hablamos?</span>

</a>

<style>
  .whatsapp-float {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 9999;

    display: flex;
    align-items: center;
    gap: 9px;

    padding: 13px 18px;
    border-radius: 50px;

    background: #25D366;
    color: white;

    text-decoration: none;
    font-family: Arial, sans-serif;
    font-size: 15px;
    font-weight: 600;

    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.20);

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .whatsapp-float:hover {
    transform: translateY(-3px);
    box-shadow: 0 7px 24px rgba(0, 0, 0, 0.25);
  }

  .whatsapp-float svg {
    width: 25px;
    height: 25px;
    fill: white;
  }

  @media (max-width: 600px) {
    .whatsapp-float {
      right: 16px;
      bottom: 16px;
      width: 56px;
      height: 56px;
      padding: 0;
      justify-content: center;
      border-radius: 50%;
    }

    .whatsapp-float span {
      display: none;
    }

    .whatsapp-float svg {
      width: 28px;
      height: 28px;
    }
  }
</style>

</body>

</html>
