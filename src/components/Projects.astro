<!-- =========================================
     LIGHTBOX
========================================== -->

<div
  class="project-lightbox"
  id="project-lightbox"
  aria-hidden="true"
>

  <button
    class="project-lightbox-close"
    type="button"
    aria-label="Cerrar proyecto"
  >
    ×
  </button>


  <div class="project-lightbox-content">

    <img
      id="project-lightbox-image"
      src=""
      alt=""
    >

    <h3 id="project-lightbox-title"></h3>

  </div>

</div>


<script>

  const projectItems =
    document.querySelectorAll(".project-item");

  const lightbox =
    document.querySelector("#project-lightbox");

  const lightboxImage =
    document.querySelector("#project-lightbox-image");

  const lightboxTitle =
    document.querySelector("#project-lightbox-title");

  const lightboxClose =
    document.querySelector(".project-lightbox-close");


  if (
    projectItems.length &&
    lightbox &&
    lightboxImage &&
    lightboxTitle &&
    lightboxClose
  ) {


    const openLightbox = (item) => {

      const image =
        item.getAttribute("data-image");

      const title =
        item.getAttribute("data-title");


      if (!image || !title) {
        return;
      }


      lightboxImage.src = image;

      lightboxImage.alt = title;

      lightboxTitle.textContent = title;


      lightbox.classList.add("is-open");

      lightbox.setAttribute(
        "aria-hidden",
        "false"
      );


      document.body.classList.add(
        "project-lightbox-open"
      );

    };


    const closeLightbox = () => {

      lightbox.classList.remove(
        "is-open"
      );

      lightbox.setAttribute(
        "aria-hidden",
        "true"
      );


      document.body.classList.remove(
        "project-lightbox-open"
      );

    };


    projectItems.forEach((item) => {

      item.addEventListener(
        "click",
        () => {
          openLightbox(item);
        }
      );

    });


    lightboxClose.addEventListener(
      "click",
      closeLightbox
    );


    lightbox.addEventListener(
      "click",
      (event) => {

        if (event.target === lightbox) {
          closeLightbox();
        }

      }
    );


    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape" &&
          lightbox.classList.contains("is-open")
        ) {
          closeLightbox();
        }

      }
    );

  }

</script>